<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record id="view_transaction_tracker_line_tree" model="ir.ui.view">
        <field name="name">transaction.tracker.line.tree</field>
        <field name="model">transaction.tracker.line</field>
        <field name="arch" type="xml">
            <list string="Transaction Lines" create="0" delete="0" edit="0" decoration-danger="payment_status=='not_paid'" decoration-success="payment_status=='paid'" decoration-warning="payment_status=='partial'">
                <field name="date"/>
                
                <field name="is_direct" column_invisible="1"/>
                
                <field name="transaction_type" widget="badge" 
                       invisible="is_direct == True"
                       decoration-info="transaction_type == 'sale'" 
                       decoration-primary="transaction_type == 'purchase'"
                       decoration-warning="transaction_type == 'manufacturing'"
                       decoration-muted="transaction_type == 'internal'"/>
                
                <field name="direct_label" widget="badge" decoration-danger="1"
                       invisible="is_direct == False"/>
                       
                <field name="reference" string="Ref &amp; Loc"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="partner_id"/>
                
                <field name="delivery_progress" widget="progressbar" string="Progress %" optional="show"/>
                
                <field name="amount_total" string="Value/Price" sum="Total Value" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                
                <field name="material_cost" string="Total Cost (HPP)" widget="monetary" options="{'currency_field': 'currency_id'}" optional="hide"/>
                
                <field name="amount_variance" string="Diff/Var" widget="monetary" 
                       options="{'currency_field': 'currency_id'}" 
                       decoration-danger="amount_variance &lt; -1 or amount_variance &gt; 1" 
                       optional="show"/>
                
                <field name="balance_due" sum="Total Due" widget="monetary" decoration-danger="balance_due > 0" options="{'currency_field': 'currency_id'}"/>
                
                <field name="currency_id" column_invisible="1"/>
                
                <field name="status_display" widget="badge" decoration-muted="status_display in ('draft', 'cancel')" decoration-success="status_display in ('sale', 'purchase', 'done')"/>
                
                <field name="payment_status" widget="badge" decoration-danger="payment_status == 'not_paid'" decoration-success="payment_status == 'paid'" decoration-warning="payment_status == 'partial'"/>
                
                <field name="invoice_date_due" optional="hide" widget="remaining_days"/>

                <field name="related_picking_display" string="Next Step / Scrap" optional="show"/>
                <field name="related_invoice_display" optional="hide"/>
                
                <button name="action_open_source_document" type="object" string="View" icon="fa-external-link" class="btn-primary"/>
            </list>
        </field>
    </record>

    <record id="view_transaction_tracker_form" model="ir.ui.view">
        <field name="name">transaction.tracker.form</field>
        <field name="model">transaction.tracker</field>
        <field name="arch" type="xml">
            <form string="Transaction Audit" class="o_form_view_container">
                <header>
                    <button name="action_scan_transactions" string="Scan Transactions" type="object" class="oe_highlight" icon="fa-refresh"/>
                </header>
                
                <div style="padding: 20px; background-color: white; min-height: 100vh;">
                    
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Audit Reference"/>
                        </h1>
                    </div>

                    <div class="alert alert-info" role="alert" style="margin-bottom: 20px; border-left: 5px solid #00A09D;">
                        <div style="display: flex; align-items: flex-start;">
                            <div style="margin-right: 15px; font-size: 24px;">
                                <i class="fa fa-info-circle"/>
                            </div>
                            <div>
                                <h4 style="margin-top: 0; color: #005c5a;">Audit Guide &amp; Legend</h4>
                                <div class="row">
                                    <div class="col-md-4">
                                        <strong><i class="fa fa-exclamation-triangle text-warning"/> Direct Transaction:</strong><br/>
                                        Marked as <span class="badge text-bg-danger">DIRECT</span>. Means invoice has no PO/SO source (Orphan).
                                    </div>
                                    <div class="col-md-4">
                                        <strong><i class="fa fa-balance-scale text-danger"/> Variance (Diff):</strong><br/>
                                        Value in <span class="text-danger font-weight-bold">RED</span> means the Bill amount differs from the PO amount.
                                    </div>
                                    <div class="col-md-4">
                                        <strong><i class="fa fa-cogs text-primary"/> Manufacturing HPP:</strong><br/>
                                        Total Cost includes: <br/><i>(Raw Material + Labor Cost + Machine Overhead)</i>.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <group string="Audit Parameters">
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="view_filter" widget="selection" style="font-weight: bold; color: #714B67;"/>
                        </group>
                    </group>

                    <group>
                        <field name="tracking_type" widget="radio" options="{'horizontal': true}"/>
                    </group>

                    <separator string="Audit Results"/>
                    <field name="line_ids" invisible="1"/>
                    
                    <field name="visible_line_ids"/>

                </div>
            </form>
        </field>
    </record>

    <record id="view_transaction_tracker_tree" model="ir.ui.view">
        <field name="name">transaction.tracker.tree</field>
        <field name="model">transaction.tracker</field>
        <field name="arch" type="xml">
            <list string="Transaction Trackers">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="tracking_type"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="create_date" string="Created On"/>
            </list>
        </field>
    </record>

    <record id="action_transaction_tracker" model="ir.actions.act_window">
        <field name="name">Transaction Link Tracker</field>
        <field name="res_model">transaction.tracker</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Create a new Transaction Audit
          </p>
          <p>
            Define a date range and click "Scan Transactions" to visualize the flow of Sales and Purchase documents.
          </p>
        </field>
    </record>

    <menuitem id="menu_transaction_tracker_root" 
              name="Transaction Tracker" 
              web_icon="transaction_tracker,static/description/icon.png"
              sequence="10"/>

    <menuitem id="menu_transaction_tracker_main" 
              name="Audit Transactions" 
              parent="menu_transaction_tracker_root" 
              action="action_transaction_tracker" 
              sequence="1"/>

  </data>
</odoo>